# Alvin Custom Direct Rules
# Domains that should bypass proxy and connect directly

# MinerU / OpenXLab CDN
DOMAIN-SUFFIX,openxlab.org.cn
DOMAIN-SUFFIX,openxlab.org
DOMAIN-SUFFIX,cdngslb.com

# Synology NAS
DOMAIN-SUFFIX,synology.com
DOMAIN-SUFFIX,synology.me
DOMAIN-SUFFIX,quickconnect.to
DOMAIN-SUFFIX,quickconnect.cn

# Xiaomi / Mi Home (account auth, MiHome cloud API, Mijia devices)
DOMAIN-SUFFIX,xiaomi.com
DOMAIN-SUFFIX,mi.com
DOMAIN-SUFFIX,mijia.com
DOMAIN-SUFFIX,miui.com

# Shinhan Financial Group (proxy exits misroute the Korean origin)
DOMAIN-SUFFIX,shinhangroup.com

# LabWorks public gateway: avoid the slow proxy hop before Oracle/FRP
DOMAIN-SUFFIX,alvinnic.dpdns.org
IP-CIDR,168.107.55.139/32,no-resolve

# GitHub release uploads from production Mac .101 and comparison .88
AND,((SRC-IP-CIDR,192.168.1.88/32),(DOMAIN,uploads.github.com))
AND,((SRC-IP-CIDR,192.168.1.101/32),(DOMAIN,uploads.github.com))
